# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
/android/build/

# Local machine config
/android/local.properties

# Flutter generated (don’t commit)
**/Flutter/Generated.xcconfig
**/Flutter/flutter_export_environment.sh
**/Flutter/ephemeral/
windows/flutter/ephemeral/

# Local backups
lib/_mojibake_backup_*/
lib/*.bak*
lib/*.corrupted*
*.bak_mojifix
