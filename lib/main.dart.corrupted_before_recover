      Navigator.pop(context);
    }
    if (!mounted) return;

    if (result.errorMessage != null) {
      _logFirebaseDiagnostic(
        'purchase_restore',
        'restore failed: ${result.errorMessage}',
        isError: true,
        popCritical: true,
      );
      final String err =
