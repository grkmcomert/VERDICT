rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function debugAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/debug_admins/$(request.auth.uid));
    }

    match /debug_admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update, delete: if false;
    }

    match /ig_users/{userId} {
      allow create, update: if signedIn();
      allow read: if debugAdmin();
      allow delete: if false;

      match /sessions/{sessionId} {
        allow create, update: if signedIn();
        allow read: if debugAdmin();
        allow delete: if false;
      }
    }

    match /owner_push_tokens/{ownerId}/devices/{uid} {
      allow read: if debugAdmin();
      allow create, update: if debugAdmin()
        && ownerId == "grkmcomert"
        && request.auth.uid == uid
        && request.resource.data.owner == "grkmcomert"
        && request.resource.data.username_key == "grkmcomert"
        && request.resource.data.auth_uid == uid;
      allow delete: if debugAdmin()
        && ownerId == "grkmcomert"
        && request.auth.uid == uid;
    }

    match /daily_stats/{dayId} {
      allow create, update: if signedIn();
      allow read: if signedIn();
      allow delete: if false;
    }

    match /test_collection/{docId} {
      allow create, update: if signedIn();
      allow read, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
